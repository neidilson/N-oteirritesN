# =========================================================
# N - NÃO TE IRRITES | Variáveis de Ambiente (Produção)
# =========================================================

# Ambiente de execução ("production" em Render/Railway, "development" local)
NODE_ENV=production

# Porta HTTP/WebSocket usada pelo servidor Express (definida automaticamente pelo Render/Railway)
PORT=3000

# Caminho do ficheiro JSON onde são persistidas as configurações da banca (comissão, prémio e preços dos tabuleiros).
# Em plataformas com volume persistente (ex.: Render Disk / Railway Volume), aponte para a pasta montada (ex.: /data/nti_platform_config.json).
PLATFORM_CONFIG_PATH=/tmp/nti_platform_config.json
