# =========================================================
# N - NÃO TE IRRITES | Variáveis de Ambiente (Produção)
# =========================================================

# Ambiente de execução ("production" em Render/Railway, "development" local)
NODE_ENV=production

# Porta HTTP/WebSocket usada pelo servidor Express (definida automaticamente pelo Render/Railway; omissão usa 3000)
PORT=3000

# Ligação PostgreSQL obrigatória em produção (Supabase ou Neon)
# Exemplo Supabase (Session/Transaction Pooler): postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Exemplo Neon: postgresql://[USER]:[PASSWORD]@[HOST]/[DB]?sslmode=require
DATABASE_URL=

# Segredo usado para assinar sessões/tokens no servidor (gere uma string longa e aleatória em produção)
SESSION_SECRET=

# PIN de acesso ao Painel Admin N (6 dígitos)
ADMIN_PIN=123456

# [OPCIONAL] Caminho do ficheiro JSON de fallback caso DATABASE_URL não esteja definida localmente.
# Quando DATABASE_URL está configurada, todas as configurações ficam guardadas na tabela platform_settings do PostgreSQL.
# PLATFORM_CONFIG_PATH=/tmp/nti_platform_config.json

# [OPCIONAL] Chaves VAPID para Web Push (PWA) — se omitidas, o servidor arranca com push desativado
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@naoteirrites.ao

